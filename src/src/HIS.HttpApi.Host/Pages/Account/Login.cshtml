@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Settings
@using Volo.Abp.Settings
@model HIS.HttpApi.Host.Pages.Account.LoginModel
@inject IHtmlLocalizer<AccountResource> L
@inject Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.PageToolbars.IPageToolbarManager PageToolbarManager

@{
    Layout = null;
}

<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en" dir="@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Login"] - Asia Hospital</title>
    
    <!-- Conditional Bootstrap CSS (RTL vs LTR) -->
    @if (System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    }
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --primary-color: #0891b2; /* Cyan 600 */
            --primary-hover: #0e7490; /* Cyan 700 */
            --bg-overlay: rgba(15, 23, 42, 0.2); /* Reduced opacity for clearer image */
        }
        
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            position: relative;
            overflow-x: hidden; /* Prevent horizontal scroll */
        }

        /* Dedicated Full Screen Background Container */
        .bg-full-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            background: url('/images/login-bg.png') no-repeat center center;
            background-color: #115e59; /* Teal-800 fallback to hide black bars */
            background-size: cover !important; /* Force cover */
            background-attachment: fixed;
        }

        /* Dark overlay for better text readability */
        .bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-overlay);
            z-index: 0;
            pointer-events: none;
            /* Ensure overlay also covers everything */
            min-height: 100%; 
            min-width: 100%;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            /* Glassmorphism Effect */
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            padding: 3rem 2.5rem;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(255, 255, 255, 0.5);
            margin: 1rem;
        }

        .logo-container {
            text-align: center;
            margin-bottom: 2rem;
            position: relative;
        }
        
        .logo-container img {
            max-width: 140px;
            height: auto;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
            transition: transform 0.3s ease;
        }

        .logo-container img:hover {
            transform: scale(1.05);
        }

        .hospital-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 0.25rem;
            letter-spacing: -0.5px;
        }

        .hospital-subtitle {
            color: #64748b;
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            background-color: #f8fafc;
            transition: all 0.2s ease;
            font-size: 0.95rem;
        }

        /* Custom directional rounding for 12px radius */
        .rounded-start-custom { border-radius: 12px 0 0 12px; }
        .rounded-end-custom { border-radius: 0 12px 12px 0; }
        
        /* RTL Overrides for custom rounding */
        [dir="rtl"] .rounded-start-custom { border-radius: 0 12px 12px 0; }
        [dir="rtl"] .rounded-end-custom { border-radius: 12px 0 0 12px; }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(8, 145, 178, 0.1);
            background-color: #fff;
            z-index: 3;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
            border: none;
            padding: 0.9rem;
            border-radius: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-top: 1rem;
            box-shadow: 0 4px 12px rgba(8, 145, 178, 0.3);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(8, 145, 178, 0.4);
            background: linear-gradient(135deg, #06b6d4, #0891b2);
        }

        .form-check-input {
            border-radius: 6px;
            width: 1.2em;
            height: 1.2em;
            margin-top: 0.15em;
            border: 2px solid #cbd5e1;
        }
        
        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .login-footer {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        .language-switch a {
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            transition: background 0.2s;
        }
        
        .language-switch a:hover {
            background: rgba(0,0,0,0.05);
        }

        /* RTL specific adjustments */
        [dir="rtl"] .form-check-input {
            float: right;
            margin-left: 0.5em;
        }
        
        /* Ensure input group text matches input styling */
        .input-group-text {
            border: 2px solid #e2e8f0;
            background-color: #f8fafc;
        }
    </style>
</head>
<body>

    <!-- Fixed Background Elements -->
    <div class="bg-full-screen"></div>
    <div class="bg-overlay"></div>

    <div class="login-card">
        <!-- Logo & Header -->
        <div class="logo-container">
             <img src="/images/logo/Dark.png" alt="Asia Hospital Logo" />
             <div class="mt-3">
                 <h1 class="hospital-name">مستشفى آسيا</h1>
                 <div class="hospital-subtitle">Asia Hospital</div>
             </div>
        </div>

        <div class="login-body">
            <form method="post">
                @if (Model.EnableLocalLogin)
                {
                    <div class="mb-4">
                        <label asp-for="LoginInput.UserNameOrEmailAddress" class="form-label">@L["UserNameOrEmailAddress"]</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-2 border-end-0 rounded-start-custom text-muted"><i class="fas fa-user"></i></span>
                            <input asp-for="LoginInput.UserNameOrEmailAddress" class="form-control border-start-0 rounded-end-custom ps-2" placeholder="username@domain.com" />
                        </div>
                        <span asp-validation-for="LoginInput.UserNameOrEmailAddress" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LoginInput.Password" class="form-label">@L["Password"]</label>
                        <div class="input-group">
                             <span class="input-group-text bg-light border-2 border-end-0 rounded-start-custom text-muted"><i class="fas fa-lock"></i></span>
                            <input asp-for="LoginInput.Password" type="password" class="form-control border-start-0 rounded-end-custom ps-2" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="LoginInput.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="LoginInput.RememberMe" class="form-check-input" />
                            <label asp-for="LoginInput.RememberMe" class="form-check-label text-secondary small">@L["RememberMe"]</label>
                        </div>
                        <a href="@Url.Page("/Account/ForgotPassword")" class="text-decoration-none small text-primary fw-semibold">@L["ForgotPassword"]</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        <i class="fas fa-sign-in-alt me-2"></i> @L["Login"]
                    </button>
                    
                    <!-- External Providers (Hidden if unused) -->
                    @if (Model.VisibleExternalProviders.Any())
                    {
                        <div class="text-center mt-3">
                             <p class="text-muted small mb-2">@L["OrLoginWith"]</p>
                             @foreach (var provider in Model.VisibleExternalProviders)
                             {
                                 <button type="submit" 
                                         class="btn btn-outline-light text-dark border shadow-sm btn-sm m-1" 
                                         name="provider" 
                                         value="@provider.AuthenticationScheme">
                                     @provider.DisplayName
                                 </button>
                             }
                        </div>
                    }
                }

                @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
                {
                    <div class="alert alert-warning shadow-sm border-0">
                        @L["NoAllowedProvider"]
                    </div>
                }
            </form>
        </div>

        <!-- Footer / Language Switch -->
        <div class="login-footer text-center">
             <vc:abp-application-configuration-script />
             <vc:abp-include-application-layout-script />
             
             <!-- Client Side Validation Scripts -->
             <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
             <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
             <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

             <!-- Language Switch -->
             <div class="d-flex justify-content-center align-items-center gap-3 language-switch">
                <a href="/Abp/Languages/Switch?culture=ar&uiCulture=ar&returnUrl=@(System.Net.WebUtility.UrlEncode(Model.ReturnUrl))" class="text-decoration-none fw-bold small @(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar") ? "text-primary bg-primary bg-opacity-10" : "text-muted")">
                    <img src="https://flagcdn.com/w20/sa.png" width="20" class="me-1 rounded-1 shadow-sm" alt="Arabic"> العربية
                </a>
                <span class="text-muted opacity-25">|</span>
                <a href="/Abp/Languages/Switch?culture=en&uiCulture=en&returnUrl=@(System.Net.WebUtility.UrlEncode(Model.ReturnUrl))" class="text-decoration-none fw-bold small @(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("en") ? "text-primary bg-primary bg-opacity-10" : "text-muted")">
                    <img src="https://flagcdn.com/w20/us.png" width="20" class="me-1 rounded-1 shadow-sm" alt="English"> English
                </a>
            </div>
            <div class="mt-3 text-muted opacity-50 small">
                &copy; @DateTime.Now.Year Asia Hospital. All rights reserved.
            </div>
        </div>
    </div>

</body>
</html>
